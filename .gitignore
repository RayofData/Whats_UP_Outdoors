# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.py[cod]

# Generated data
data/raw/*
data/processed/*

# Keep empty data folders in Git
!data/raw/.gitkeep
!data/processed/.gitkeep

# Bundle the final app-ready demo data
!data/processed/dnr_up_hiking_trails_grouped.parquet
!data/processed/inaturalist_up_fall_observations.parquet

# Jupyter temporary files
.ipynb_checkpoints/

# Local environment variables
.env
